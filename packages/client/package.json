{
  "name": "@streamweld/client",
  "version": "0.1.0",
  "description": "Dependency-free durable streaming client for Streamweld",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamweld/streamweld.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/streamweld/streamweld#readme",
  "bugs": {
    "url": "https://github.com/streamweld/streamweld/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  }
}
