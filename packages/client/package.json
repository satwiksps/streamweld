{
  "name": "@streamweld/client",
  "version": "1.0.0",
  "description": "Dependency-free durable streaming client for Streamweld",
  "keywords": [
    "llm",
    "openai",
    "resumable",
    "server-sent-events",
    "streaming",
    "typescript"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satwiksps/streamweld.git",
    "directory": "packages/client"
  },
  "homepage": "https://streamweld.readthedocs.io/en/latest/sdk/typescript/",
  "bugs": {
    "url": "https://github.com/satwiksps/streamweld/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:runtime": "node --expose-gc --test test/runtime-http.mjs",
    "typecheck": "tsc --project tsconfig.json"
  }
}
