{
  "name": "@streamweld/ai-sdk",
  "version": "1.0.1",
  "description": "Vercel AI SDK v5 transport adapter for Streamweld",
  "keywords": [
    "ai-sdk",
    "llm",
    "openai",
    "resumable",
    "streaming",
    "vercel"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satwiksps/streamweld.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://streamweld.readthedocs.io/en/latest/sdk/typescript/",
  "bugs": {
    "url": "https://github.com/satwiksps/streamweld/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@streamweld/client": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=5.0.244 <6.0.0"
  },
  "devDependencies": {
    "ai": "5.0.244"
  }
}
