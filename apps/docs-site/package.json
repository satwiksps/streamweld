{
  "name": "@streamweld/docs-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/sync-source-docs.mjs && astro dev",
    "start": "node ./scripts/sync-source-docs.mjs && astro dev",
    "build": "node ./scripts/sync-source-docs.mjs && astro build && vite build --config vite.config.ts",
    "build:astro": "node ./scripts/sync-source-docs.mjs && astro build",
    "preview": "vite preview --config vite.config.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.9",
    "astro": "^7.2.9",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.17.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260827.1",
    "@openai/sites-vite-plugin": "0.2.0"
  }
}
