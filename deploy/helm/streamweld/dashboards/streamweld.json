      "type": "stat",
      "title": "Journal degraded",
      "targets": [{"expr": "max(streamweld_journal_degraded)", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Migrations",
